# Copy to .env and fill in. .env is gitignored.

# Your Meta app credentials (developers.facebook.com -> your app -> Settings -> Basic)
META_APP_ID=
META_APP_SECRET=

# Default access token used for every account that does not set its own "token_env".
# Start with a 60-day long-lived User token; swap for a no-expiry System User token later.
META_ACCESS_TOKEN=

# Optional per-account tokens, referenced by "token_env" in accounts.json
# META_TOKEN_BRAND_A=
# META_TOKEN_BRAND_B=
